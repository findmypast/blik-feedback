#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if [ ! -x .venv/bin/python ]; then
    echo "Local virtual environment not found. Run 'uv sync --extra dev' first." >&2
    exit 1
fi

if ! .venv/bin/python -c "import factory, pytest" >/dev/null 2>&1; then
    echo "Development test dependencies are missing." >&2
    echo "Install uv, then run: uv sync --extra dev" >&2
    exit 1
fi

echo "Running local tests before push..."
.venv/bin/python -m pytest -q --tb=short --disable-warnings
